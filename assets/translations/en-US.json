  "termsAndConditions": {
    "title": "Terms & Conditions",
    "subtitle": "Please read the following terms & conditions carefully before continuing.",
    "section1Title": "1. Acceptance of Terms",
    "section1Text": "By creating an account or using the app, you agree to comply with these Terms & Conditions. If you do not agree, please stop using the app.",
    "section2Title": "2. Purpose of the App",
    "section2Text": "Nufud helps users discover events, explore experiences, plan trips, and interact with AI-powered features such as image analysis and recommendations. The app is for personal, non-commercial use only.",
    "section3Title": "3. User Responsibilities",
    "section3Text": "You agree to:",
    "section3Bullet1": "Use the app respectfully and lawfully.",
    "section3Bullet2": "Provide accurate information when creating an account.",
    "section3Bullet3": "Not misuse any feature, including AI tools, image uploads, or event posting.",
    "section3Bullet4": "Not upload harmful, inappropriate, or copyrighted content that you do not own.",
    "section4Title": "4. Event Posting & Community Content",
    "section4Text": "If you post an event or activity:",
    "section4Bullet1": "You are responsible for the accuracy of your information.",
    "section4Bullet2": "Nufud does not verify or guarantee event details.",
    "section4Bullet3": "Nufud is not responsible for interactions between users or for any issues that occur during events.",
    "section5Title": "5. AI Features",
    "section5Text": "Nufud includes AI features such as trip planning, recommendations, and image analysis. These features:",
    "section5Bullet1": "Provide suggestions only, not guarantees.",
    "section5Bullet2": "May not always be accurate or complete.",
    "section5Bullet3": "Should not be used for safety-critical decisions.",
    "section6Title": "6. Privacy & Data",
    "section6Text": "We collect and process data to improve your experience. This may include:",
    "section6Bullet1": "Account information",
    "section6Bullet2": "Uploaded images",
    "section6Bullet3": "Location (if you choose to allow it)",
    "section6Bullet4": "App usage analytics",
    "section6Bullet5": "We do not sell your personal data to third parties. For more details, refer to our Privacy Policy.",
    "section7Title": "7. Prohibited Activities",
    "section7Text": "You agree NOT to:",
    "section7Bullet1": "Use the app for illegal or harmful activities.",
    "section7Bullet2": "Upload content containing violence, hate, harassment, or explicit material.",
    "section7Bullet3": "Attempt to hack, reverse engineer, or misuse the app.",
    "section7Bullet4": "Impersonate other users or create fake content.",
    "section8Title": "8. Intellectual Property",
    "section8Text": "All branding, design, content, and app features belong to Nufud. You may not copy, reproduce, or redistribute any part of the app without permission.",
    "section9Title": "9. Limitation of Liability",
    "section9Text": "Nufud is not responsible for:",
    "section9Bullet1": "Event cancellations, misinformation, or disputes between users",
    "section9Bullet2": "Damages resulting from the use of AI features",
    "section9Bullet3": "Loss of data or technical issues",
    "section9Bullet4": "You use the app at your own risk.",
    "section10Title": "10. Changes to the Terms",
